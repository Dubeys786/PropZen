        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "location",
              "value": "Sector 150"
            },
            {
              "name": "city",
              "value": "Noida"
            }
          ]
        }
      },
      "name": "Call: Apify Permitted Scraper Gateway",
      "type": "n8n-nodes-base.httpRequest",
