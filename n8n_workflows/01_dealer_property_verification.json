{
  "name": "01_PropZen_Dealer_Property_Verification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "propzen/dealer-property-verify",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook: Dealer Property Submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/v1/ai/verify-property",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-PropZen-Key",
              "value": "={{$env.AI_ENGINE_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "property_id",
              "value": "={{$json.body.property_id}}"
            },
            {
              "name": "dealer_id",
              "value": "={{$json.body.dealer_id}}"
            },
            {
              "name": "title",
              "value": "={{$json.body.title}}"
            },
            {
              "name": "asking_price_cr",
              "value": "={{$json.body.price_cr}}"
            },
            {
              "name": "sqft",
              "value": "={{$json.body.sqft}}"
            },
            {
              "name": "locality",
              "value": "={{$json.body.locality}}"
            },
            {
              "name": "rera_number",
              "value": "={{$json.body.rera_number}}"
            },
            {
              "name": "document_types",
              "value": "={{$json.body.document_types || []}}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "name": "Call: LangGraph AI Verification Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "value2": "VERIFIED"
            }
          ]
        }
      },
      "name": "IF: Verification Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "properties",
        "id": "={{$json.property_id}}",
        "updateFields": {
          "fields": [
            {
              "name": "verification_status",
              "value": "verified"
            },
            {
              "name": "status",
              "value": "published"
            },
            {
              "name": "verification_score",
              "value": "={{$json.confidence * 100}}"
            },
            {
              "name": "risk_score",
              "value": "={{$json.risk_score}}"
            }
          ]
        }
      },
      "name": "Supabase: Auto-Publish Property",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "properties",
        "id": "={{$json.property_id}}",
        "updateFields": {
          "fields": [
            {
              "name": "verification_status",
              "value": "needs_review"
            },
            {
              "name": "status",
              "value": "under_review"
            },
            {
              "name": "risk_score",
              "value": "={{$json.risk_score}}"
            },
            {
              "name": "missing_documents",
              "value": "={{JSON.stringify($json.missing_documents)}}"
            }
          ]
        }
      },
      "name": "Supabase: Send to Admin Human Review",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [960, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify($json)}}"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook: Dealer Property Submission": {
      "main": [
        [
          {
            "node": "Call: LangGraph AI Verification Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call: LangGraph AI Verification Engine": {
      "main": [
        [
          {
            "node": "IF: Verification Passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Verification Passed?": {
      "main": [
        [
          {
            "node": "Supabase: Auto-Publish Property",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Supabase: Send to Admin Human Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: Auto-Publish Property": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: Send to Admin Human Review": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
