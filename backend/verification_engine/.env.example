# PropZen GlobalVerificationEngine Environment Configuration

# Service Settings
VERIFICATION_HOST=0.0.0.0
VERIFICATION_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Limits
# If empty, auth middleware allows development/local requests
API_KEY_SECRET=PropZen_Verification_SecKey_2026
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,https://propzen.ai

# AI Extraction Provider ('synthetic', 'gemini', 'openai')
AI_PROVIDER=synthetic

# External AI Provider Keys (Optional when AI_PROVIDER=synthetic)
GEMINI_API_KEY=AIzaSy_placeholder_gemini_key
OPENAI_API_KEY=sk_placeholder_openai_key

# Supabase Persistence Configuration
SUPABASE_URL=https://eemxylswyvhsyzllcsnp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey_service_role_placeholder
SUPABASE_ANON_KEY=sb_publishable_placeholder

# Fallback In-Memory Repository (set true to test without live Supabase connection)
ENABLE_MOCK_REPO=true
