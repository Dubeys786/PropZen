# =============================================================================
# PropZen Java Enterprise Backend — Environment Variables Template
# =============================================================================
# Duplicate this file to .env or export these variables in your deployment environment.
# Never commit production secrets, keys, or passwords to source control.
# =============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Supabase / PostgreSQL)
# Format: jdbc:postgresql://<db_host>:<port>/<db_name>?sslmode=require
DATABASE_URL=jdbc:postgresql://db.eemxylswyvhsyzllcsnp.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_db_password_here
DATABASE_DRIVER=org.postgresql.Driver
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5
DB_IDLE_TIMEOUT=600000
DB_CONNECTION_TIMEOUT=30000
DB_MAX_LIFETIME=1800000
DB_KEEPALIVE_TIME=30000

# Supabase Client & Storage Configuration
SUPABASE_URL=https://eemxylswyvhsyzllcsnp.supabase.co
SUPABASE_ANON_KEY=sb_publishable_VfKv6fXe243_FfAHo8t1DA_uBwIP0YS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_JWKS_URL=https://eemxylswyvhsyzllcsnp.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://eemxylswyvhsyzllcsnp.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# CORS Allowed Origins (Comma-separated list of origins)
PROPZEN_ALLOWED_ORIGINS=https://propzen.ai,https://app.propzen.ai,https://admin.propzen.ai

# Security Bootstrapping
PROPZEN_BOOTSTRAP_ADMIN_EMAILS=admin@propzen.ai

# Official Meta WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id_here
PROPZEN_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
PROPZEN_OUTBOX_POLL_INTERVAL_MS=5000

# Payment Gateways (Provider Abstraction)
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
PAYU_KEY=your_payu_merchant_key_here
PAYU_SALT=your_payu_salt_here

# Notification Providers (Email, SMS)
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_key_here
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+1234567890
