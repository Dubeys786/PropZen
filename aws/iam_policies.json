{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PropZenS3MediaBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::propzen-verified-media-*",
        "arn:aws:s3:::propzen-verified-media-*/*"
      ]
    },
    {
      "Sid": "PropZenKmsEnvelopeCryptoAccess",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:*:*:key/*"
    },
    {
      "Sid": "PropZenCloudWatchLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/propzen/*"
    }
  ]
}
