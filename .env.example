# ==============================================================================
# PropZen Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECURE SECRETS BEFORE DEPLOYMENT
# NEVER COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# Supabase Client Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-256-bits

# Backend Database (PostgreSQL / Supabase Transaction Pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-secure-db-password

# Application Profile & Admin Configuration
PROPZEN_ENV=production
PROPZEN_BOOTSTRAP_ADMIN_EMAILS=security-admin@propzen.ai

# n8n Workflow Automation Engine
N8N_BOOK_SITE_VISIT_URL=https://your-n8n-instance.cloud/webhook/propzen/site-visit
N8N_PROPERTY_ENQUIRY_URL=https://your-n8n-instance.cloud/webhook/propzen/enquiry
N8N_PROPERTY_DATA_URL=https://your-n8n-instance.cloud/webhook/propzen/property
N8N_SERVICES_URL=https://your-n8n-instance.cloud/webhook/propzen/services
N8N_VERIFY_DOCUMENT_URL=https://your-n8n-instance.cloud/webhook/propzen/verify-document
N8N_OFFICIAL_SOURCE_CHECK_URL=https://your-n8n-instance.cloud/webhook/propzen/verify-source
N8N_QUESTION_GENERATOR_URL=https://your-n8n-instance.cloud/webhook/propzen/verification-question
N8N_PROPERTY_MONITOR_URL=https://your-n8n-instance.cloud/webhook/propzen/property-monitor
N8N_API_KEY=your-high-entropy-n8n-api-key

# Razorpay Payment Gateway (Production: switch to LIVE keys and LIVE mode)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_MODE=LIVE

# Meta / WhatsApp Business Cloud API
PROPZEN_WHATSAPP_API_URL=https://graph.facebook.com/v19.0
PROPZEN_WHATSAPP_API_TOKEN=your-meta-whatsapp-bearer-token
PROPZEN_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
PROPZEN_WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
PROPZEN_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-meta-verify-token-at-least-32-chars
PROPZEN_WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-sha256

# AI Engine & Encryption Keys
AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_ENGINE_API_KEY=your-ai-engine-bearer-secret
MASTER_KEK_SECRET=your-master-kek-aes256-gcm-hex-key
KMS_KEY_VERSION=1
CANONICAL_HOST=https://propzen.ai
